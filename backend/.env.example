PORT=5000
MONGO_URI=mongodb://username:password@cluster-host:27017/gym-tracker
MONGO_URI_BACKUP=mongodb+srv://username:password@cluster0.example.mongodb.net/gym-tracker?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nutritionix API Configuration (Optional)
NUTRITIONIX_APP_ID=your_nutritionix_app_id
NUTRITIONIX_API_KEY=your_nutritionix_api_key

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
